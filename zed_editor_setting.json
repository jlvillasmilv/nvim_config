// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_edit_predictions": false,
  "edit_predictions": {
    "disabled_globs": [],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null
    },
    "enabled_in_text_threads": false
  },
  "features": {
    "edit_prediction_provider": "copilot"
  },
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    },
    "model_parameters": [],
    "always_allow_tool_actions": true
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "file_scan_exclusions": [
    ".git/",
    "vendor/",
    "node_modules/",
    "tests/fixtures/"
  ],
  "icon_theme": "Material Icon Theme",
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard"
  },
  "languages": {
    "PHP": {
      "show_edit_predictions": true,
      "language_servers": ["!intelephense","phpactor"]
    },
    "JavaScript": {
      "language_servers": ["eslint"],
      "enable_language_server": false
    },
    "CSS": {
      "enable_language_server": false
    }
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "cursor_blink": true,
  "soft_wrap": "editor_width",
  "format_on_save": "off",
  "file_types": {
    "Blade": ["*.blade.php"]
  },
  "lsp": {
    "phpactor":{
      "initialization_options": {
        "language_server_phpstan.mem_limit":"1G",
        "language_server.diagnostics_on_update": false,
        "language_server_highlight.enabled": false,
        "indexer.exclude_patterns": ["/vendor/**/Tests/**/*","/vendor/**/tests/**/*","/var/cache/**/*","/vendor/composer/**/*"]
      }
    },
    "intelephense": {
      "settings": {
        "environment": {
          "phpVersion": "8.2.0"
        },
        "maxMemory": 256,
        "telemetry.enabled": false,
        "diagnostics.undefinedProperties": false,
        "diagnostics.run": "onSave",
        "enable": true,
        "exclude": [
          "**/.git/**",
          "**/node_modules/**",
          "**/vendor/**",
          "**/vendors/**"
        ],
        "format": {
          "enable": true
        },
        "codeAction": {
          "enable": true
        },
        "diagnostics": {
          "enable": false,
          "undefinedProperties": true,
          "include_warnings": false
        }
      }
    }
  }
}
